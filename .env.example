NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=alef
DB_PASSWORD=alef
DB_DATABASE=alef_dev
# Real migrations exist (src/database/migrations) — run `npm run
# migration:run` after starting Postgres instead of relying on this. Set to
# "true" only for quick local prototyping when you don't want to generate a
# migration for every entity tweak yet (never in an environment with real data).
DB_SYNCHRONIZE=false

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173

# Agora (https://console.agora.io -> Project Management -> create a project).
# Leave unset to use the local MockAgoraProvider instead (see MeetingsModule).
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# SMTP — used to deliver login OTP codes (auth module) and settings-module
# test emails. Leave unset to fall back to the console stub (logs instead of
# sending) for local dev.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
