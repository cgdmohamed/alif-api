NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=alef
DB_PASSWORD=alef
DB_DATABASE=alef_dev
# Keep true until real migrations exist (see README's Production notes).
DB_SYNCHRONIZE=true

JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_EXPIRES_IN=30d

CORS_ORIGIN=http://localhost:5173

# Zoom Video SDK (https://marketplace.zoom.us -> Build App -> Video SDK).
# Leave unset to use the local MockZoomProvider instead (see MeetingsModule).
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
